# ==============================================================================
# Admine ERP - Centralized System configurations Template (.env.example)
# ==============================================================================

# --- Database Credentials ---
DB_USER=user
DB_PASSWORD=password
DB_NAME=erp_db
DB_PORT=5432
DB_HOST=db

# Host-exposed port mapping for local database clients (standard: 5433)
DB_PORT_EXPOSED=5433

# --- Backend server settings ---
# The port Express.js listens to internally inside the container
PORT=3000

# Host-exposed port mapping for backend API (standard: 3001)
BACKEND_PORT_EXPOSED=3001

# --- Frontend settings ---
# Host-exposed port mapping for React + Vite development server (standard: 5180)
FRONTEND_PORT_EXPOSED=5180
