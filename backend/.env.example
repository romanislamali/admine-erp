# ==============================================================================
# Admine ERP - Centralized System configurations Template (.env.example)
# ==============================================================================

# --- Database Credentials ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_PORT=5432
DB_HOST=db

# Host-exposed port mapping for local database clients (standard: 5433)
DB_PORT_EXPOSED=5433

# --- Backend server settings ---
# The port Express.js listens to internally inside the container
PORT=3000

# Host-exposed port mapping for backend API (standard: 3001)
BACKEND_PORT_EXPOSED=3001

# --- Frontend settings ---
# Host-exposed port mapping for React + Vite development server (standard: 5180)
FRONTEND_PORT_EXPOSED=5180

# --- Email Alert Configuration (Gmail) ---
ALERT_EMAIL=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password

# --- JWT Auth settings ---
JWT_SECRET=your_jwt_secret_key_here

# --- Hidden system admin account (full ADMIN access, excluded from the users list, ---
# --- protected from update/delete). Set your own fixed credentials here. ---
SYSADMIN_USERNAME=your_system_username
SYSADMIN_PASSWORD=change_this_password

# --- Google Drive Backup Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# --- Nginx Container Exposed Ports ---
HTTP_PORT=8080
HTTPS_PORT=8443

